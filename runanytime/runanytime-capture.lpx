#!name=随时跑路 刷新凭证 v8
#!desc=仅在成功登录或刷新响应中保存 new_api_refresh，响应 Set-Cookie 优先；普通浏览不抓，重复凭证不投递。捕获端只保存、不触发签到；每日签到由服务器定时独立执行。
#!author=thyself
#!system=iOS,iPadOS
#!loon_version=3.5.1(988)
#!date=2026-11-25
#!tag=签到,工具

[Argument]
hook = input,"",tag=投递地址,desc=形如 https://ra.xxx.nip.io/<暗号>/cookie，由我提供
token = input,"",tag=令牌,desc=X-Token 的值，由我提供

[Script]
generic then script("https://ra.161.33.211.131.nip.io/s/runanytime-capture-v8.js", {${hook}, ${token}}) with img_url="stethoscope", tag="随时跑路 v8 自检", timeout=20
response if ${url} ~= /^https:\/\/runanytime\.hxi\.me\/(?:api\/user\/(?:auth\/(?:refresh|login)|login(?:\/2fa)?|passkey\/login\/finish)|api\/oauth\/[^?#]+)\/?(?:[?#]|$)/ then script("https://ra.161.33.211.131.nip.io/s/runanytime-capture-v8.js", {${hook}, ${token}}) with tag="随时跑路 刷新凭证 v8", timeout=20, requires_body=true

[MITM]
hostname = runanytime.hxi.me
