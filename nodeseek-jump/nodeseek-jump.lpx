#!name=NodeSeek 链接跳 NS Connect
#!desc=防循环 v2：只放行站点根 Referer，保护 App 正文加载；帖子 Referer 仍跳 NS Connect，修复 Safari 不弹跳转。需 v1.5.0+；停用插件可恢复网页。
#!openUrl=https://github.com/BeThyself/loon/blob/main/nodeseek-jump/README.md
#!author=thyself
#!tag=功能增强
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.5.1(978)
#!homepage=https://github.com/BeThyself/loon/tree/main/nodeseek-jump
#!date=2026-11-26

# ===================================================================
# 原理：把帖子网页 302 到 App 的自定义 scheme，由系统提示「在 NS Connect 中打开」。
#   https://www.nodeseek.com/post-139218    → nsconnect://post/139218
#   https://www.nodeseek.com/post-139218-3  → nsconnect://post/139218-3
# 思路同常见的 Telegram 重定向插件（t.me → tg://resolve），只是换目标 scheme。
#
# 前置条件：
#   1. App 版本 ≥ 1.5.0（含 nsconnect://post 路由）。自测：Safari 地址栏输入
#      nsconnect://post/139218，能进帖子页即已支持。
#   2. Loon 打开 MitM，且根证书已安装并信任，否则看不到 HTTPS 路径，规则不命中。
# ===================================================================

[Rewrite]
# NS Connect 的 HiddenWebViewHTMLClient 固定设置根 Referer：https://www.nodeseek.com/。
# 仅保护根地址（可无尾斜杠，兼容子域名/端口）；帖子/列表 Referer 仍允许 GET 跳转。
# 用户实测 Safari Referer 为 /post-1081249-1，不能把所有站内 Referer 都放行。
# 这不是进程识别：根 Referer 浏览器也放行；App 若改用帖子 Referer 或被删头仍可能误拦。不可与旧规则并存。
# 带页码：/post-139218-3 → nsconnect://post/139218-3
request if ${url} ~= /^https?:\/\/(www\.)?nodeseek\.com\/post-([0-9]+)-([0-9]+)(?:\/)?(?:\?.*)?$/i as paged && ${request.method} == "GET" && (${request.header['Referer']} == null || ${request.header['Referer']} ~= /^(?!https?:\/\/(?:[a-z0-9-]+\.)*nodeseek\.com(?::[0-9]+)?\/?$).*$/i) then redirect(302, "nsconnect://post/${paged.2}-${paged.3}")
# 不带页码：/post-139218 → nsconnect://post/139218
request if ${url} ~= /^https?:\/\/(www\.)?nodeseek\.com\/post-([0-9]+)(?:\/)?(?:\?.*)?$/i as single && ${request.method} == "GET" && (${request.header['Referer']} == null || ${request.header['Referer']} ~= /^(?!https?:\/\/(?:[a-z0-9-]+\.)*nodeseek\.com(?::[0-9]+)?\/?$).*$/i) then redirect(302, "nsconnect://post/${single.2}")

[MITM]
hostname = nodeseek.com, www.nodeseek.com
