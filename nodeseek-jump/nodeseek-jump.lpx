#!name=NodeSeek 链接跳 NS Connect
#!desc=在 Safari 或其它 App 点 NodeSeek 帖子链接时，直接改用 NS Connect 打开。需要 App 支持 nsconnect://post 深链（上游 PR 已提交，旧版本只会停在首页）。
#!openUrl=https://github.com/BeThyself/loon/blob/main/nodeseek-jump/README.md
#!author=thyself
#!tag=功能增强
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.5.1(978)
#!homepage=https://github.com/BeThyself/loon/tree/main/nodeseek-jump
#!date=2026-11-25

# ===================================================================
# 原理：把帖子网页 302 到 App 的自定义 scheme，由系统提示「在 NS Connect 中打开」。
#   https://www.nodeseek.com/post-139218    → nsconnect://post/139218
#   https://www.nodeseek.com/post-139218-3  → nsconnect://post/139218-3
# 思路同常见的 Telegram 重定向插件（t.me → tg://resolve），只是换目标 scheme。
#
# 前置条件：App 必须支持 nsconnect://post/...，否则只会打开到首页。
# 上游实现：https://github.com/tyrad/nodeseek/pull/19
# 自测：Safari 地址栏输入 nsconnect://post/139218，能进帖子页即已支持。
#
# 必须打开 MitM 且根证书已信任，否则 Loon 看不到 HTTPS 路径，规则不命中。
# ===================================================================

[Argument]
ENABLED = switch, true, tag=总开关, desc=关掉后不再拦截 NodeSeek 链接，恢复网页打开

[Rewrite]
# 带页码：/post-139218-3 → nsconnect://post/139218-3
request if ${ENABLED} == true && ${url} ~= /^https?:\/\/(www\.)?nodeseek\.com\/post-([0-9]+)-([0-9]+)(?:\/)?(?:\?|$)/ as paged then redirect(302, "nsconnect://post/${paged.2}-${paged.3}")
# 不带页码：/post-139218 → nsconnect://post/139218
request if ${ENABLED} == true && ${url} ~= /^https?:\/\/(www\.)?nodeseek\.com\/post-([0-9]+)(?:\/)?(?:\?|$)/ as single then redirect(302, "nsconnect://post/${single.2}")

[MITM]
hostname = nodeseek.com, www.nodeseek.com
