#!name=快捷搜索 Pro
#!desc=Safari 快速切换搜索引擎（可莉版扩展）。新增京东 / 淘宝 / 拼多多 / B站 / YouTube 等 App 内直接搜索
#!openUrl=https://github.com/BeThyself/loon/blob/main/QuickSearch/README.md
#!author=thyself
#!tag=功能增强
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.5.1(978)
#!homepage=https://github.com/BeThyself/loon/tree/main/QuickSearch
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Safari.png
#!date=2026-10-16

# ===================================================================
# 使用方法
#   1. 设置 → Safari → 搜索引擎 → 改为 DuckDuckGo
#   2. Safari 地址栏输入「命令 关键词」或「关键词 命令」，回车
#   3. 本插件需要 Loon 开启 MitM（已声明 hostname=duckduckgo.com）
# 说明：可莉原版 7 条命令原样保留，额外补齐了「关键词在前」的语序；
#       新增的 7 条命令两种语序都支持。
# 基底：可莉 Kelee 的 QuickSearch.lpx https://kelee.one/Tool/Loon/Lpx/QuickSearch.lpx
# ===================================================================

[Rewrite]

# ---------------------------------------------------------------- 搜索
# bd    关键词 (百度)
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=bd\+([^&]+).+/i as urlMatch then redirect(307, "https://www.baidu.com/s?wd=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+)\+bd(?:&|$)/i as urlMatch then redirect(307, "https://www.baidu.com/s?wd=${urlMatch.1}")
# bdimg 关键词 (百度图片)
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=bdimg\+([^&]+).+/i as urlMatch then redirect(307, "https://image.baidu.com/search/index?tn=baiduimage&word=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+)\+bdimg(?:&|$)/i as urlMatch then redirect(307, "https://image.baidu.com/search/index?tn=baiduimage&word=${urlMatch.1}")
# gimg  关键词 (Google 图片)
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=gimg\+([^&]+).+/i as urlMatch then redirect(307, "https://www.google.com/search?&tbm=isch&q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+)\+gimg(?:&|$)/i as urlMatch then redirect(307, "https://www.google.com/search?&tbm=isch&q=${urlMatch.1}")
# b     关键词 (必应)
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=b\+([^&]+).+/i as urlMatch then redirect(307, "https://www.bing.com/search?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+)\+b(?:&|$)/i as urlMatch then redirect(307, "https://www.bing.com/search?q=${urlMatch.1}")
# wk    关键词 (中文维基)
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=wk\+([^&]+).+/i as urlMatch then redirect(307, "https://zh.wikipedia.org/wiki/${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+)\+wk(?:&|$)/i as urlMatch then redirect(307, "https://zh.wikipedia.org/wiki/${urlMatch.1}")
# qm    关键词 (七麦数据 · 查 App)
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=qm\+([^&]+).+/i as urlMatch then redirect(307, "https://www.qimai.cn/search/index/country/cn/search/${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+)\+qm(?:&|$)/i as urlMatch then redirect(307, "https://www.qimai.cn/search/index/country/cn/search/${urlMatch.1}")
# gh    关键词 (GitHub)
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=gh\+([^&]+).+/i as urlMatch then redirect(307, "https://github.com/search?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+)\+gh(?:&|$)/i as urlMatch then redirect(307, "https://github.com/search?q=${urlMatch.1}")

# ---------------------------------------------------------------- 购物 (唤起 App)
# jd    关键词 (京东 App 内搜索)
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=jd\+([^&]+).+/i as urlMatch then redirect(307, "openapp.jdmobile://virtual?params={\"des\":\"productList\",\"keyWord\":\"${urlMatch.1}\",\"from\":\"search\",\"category\":\"jump\"}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+)\+jd(?:&|$)/i as urlMatch then redirect(307, "openapp.jdmobile://virtual?params={\"des\":\"productList\",\"keyWord\":\"${urlMatch.1}\",\"from\":\"search\",\"category\":\"jump\"}")
# tb    关键词 (淘宝 App 内搜索)
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=tb\+([^&]+).+/i as urlMatch then redirect(307, "taobao://s.taobao.com?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+)\+tb(?:&|$)/i as urlMatch then redirect(307, "taobao://s.taobao.com?q=${urlMatch.1}")
# pdd   关键词 (拼多多 App 内搜索)
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=pdd\+([^&]+).+/i as urlMatch then redirect(307, "pinduoduo://com.xunmeng.pinduoduo/search_result.html?search_key=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+)\+pdd(?:&|$)/i as urlMatch then redirect(307, "pinduoduo://com.xunmeng.pinduoduo/search_result.html?search_key=${urlMatch.1}")

# ---------------------------------------------------------------- 视频 (唤起 App)
# yt    关键词 (YouTube App 内搜索)
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=yt\+([^&]+).+/i as urlMatch then redirect(307, "youtube://results?search_query=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+)\+yt(?:&|$)/i as urlMatch then redirect(307, "youtube://results?search_query=${urlMatch.1}")
# bli   关键词 (哔哩哔哩 App 内搜索)
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=bli\+([^&]+).+/i as urlMatch then redirect(307, "bilibili://search?keyword=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+)\+bli(?:&|$)/i as urlMatch then redirect(307, "bilibili://search?keyword=${urlMatch.1}")

# ---------------------------------------------------------------- 社交
# wx    关键词 (微信 · 搜狗微信，网页版，微信没有可用的搜索深链)
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=wx\+([^&]+).+/i as urlMatch then redirect(307, "https://weixin.sogou.com/weixinwap?query=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+)\+wx(?:&|$)/i as urlMatch then redirect(307, "https://weixin.sogou.com/weixinwap?query=${urlMatch.1}")
#   └ 若只想唤起微信 App（不能带关键词，仅打开微信），把上面两行注释掉，改用下面这个：
# request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=wx\+/i then redirect(307, "weixin://")

# tg    关键词 (电报 · iOS 端无搜索深链，只能唤起 App 本身，关键词不会带过去)
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=tg\+/i then redirect(307, "tg://")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+)\+tg(?:&|$)/i then redirect(307, "tg://")

# ---------------------------------------------------------------- 默认 (无命令)
# 未带任何命令时走 Google。负向预查避免吃掉上面带命令的请求。
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=(?!(?:bd|bdimg|gimg|b|wk|qm|gh|jd|tb|pdd|yt|bli|wx|tg)\+)(?![^&]+\+(?:bd|bdimg|gimg|b|wk|qm|gh|jd|tb|pdd|yt|bli|wx|tg)(?:&|$))([^&]+).+/i as urlMatch then redirect(307, "https://www.google.com/search?q=${urlMatch.1}")

[MitM]
hostname=duckduckgo.com
